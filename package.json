{
  "name": "floaty",
  "version": "1.0.0",
  "description": "Cross-platform floating always-on-top mirror camera window (macOS/Windows/Linux)",
  "main": "src/main.js",
  "license": "MIT",
  "type": "commonjs",
  "author": {
    "name": "Sohail",
    "email": "sohelislamblg01@gmail.com",
    "url": "https://github.com/sohail22dec"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sohail22dec/floaty.git"
  },
  "bugs": {
    "url": "https://github.com/sohail22dec/floaty/issues"
  },
  "homepage": "https://github.com/sohail22dec/floaty#readme",
  "keywords": [
    "electron",
    "camera",
    "floating",
    "webcam",
    "always-on-top",
    "cross-platform"
  ],
  "scripts": {
    "start": "electron . --no-sandbox --enable-transparent-visuals --disable-gpu",
    "dev": "NODE_ENV=development electron . --enable-logging --no-sandbox --enable-transparent-visuals --disable-gpu",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac-arm": "electron-builder --mac --arm64",
    "build:mac-intel": "electron-builder --mac --x64",
    "build:mac-universal": "electron-builder --mac --universal",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "dist": "npm run build",
    "dist:all": "electron-builder --mac --win --linux",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,html,css}\"",
    "test": "echo \"No tests specified\" && exit 0",
    "clean": "rm -rf dist build node_modules/.cache"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  },
  "build": {
    "appId": "com.sohail.floaty",
    "productName": "Floaty",
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!**/.DS_Store"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.photography",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "This app needs camera access to display video feed in the floating window.",
        "NSMicrophoneUsageDescription": "This app may need microphone access for video recording features.",
        "LSUIElement": true,
        "CFBundleDocumentTypes": []
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "title": "${productName} ${version}",
      "backgroundColor": "#2c2c2c",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "Sohail",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Floaty"
    },
    "linux": {
      "maintainer": "Sohail <sohelislamblg01@gmail.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/",
      "category": "AudioVideo",
      "desktop": {
        "Name": "Floaty",
        "Comment": "Cross-platform floating camera",
        "Categories": "AudioVideo;Photography;",
        "Keywords": "camera;webcam;floating;video;"
      }
    },
    "appImage": {
      "license": "LICENSE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sohail22dec",
        "repo": "floaty",
        "private": false
      }
    ],
    "afterSign": "scripts/notarize.js"
  }
}
